<%- include('partials/head', { title }) %>
<section class="auth-stage">
    <div class="auth-showcase">
        <div class="auth-copy">
            <span class="eyebrow light">Bienvenido</span>
            <h1>Inicia sesion y entra a tu espacio segun tu rol.</h1>
            <p>Tu JWT se guarda en `sessionStorage` y desde ahi protegemos perfil, dashboards y redirecciones.</p>
        </div>
        <div class="card-panel form-card auth-form-card">
            <h4>Sign in</h4>
            <p class="form-subtitle">Ingresa tus credenciales para continuar.</p>
            <form id="sign-in-form">
                <div class="input-field">
                    <input id="email" name="email" type="email" required>
                    <label for="email">Email</label>
                </div>
                <div class="input-field">
                    <input id="password" name="password" type="password" required>
                    <label for="password">Password</label>
                </div>
                <button class="btn waves-effect waves-light full-width" type="submit">Ingresar</button>
            </form>
            <p class="helper-text top-space">¿No tienes cuenta? <a href="/signUp">Registrate aqui</a>.</p>
        </div>
    </div>
</section>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        window.App.bindSignInForm();
    });
</script>
<%- include('partials/foot') %>
