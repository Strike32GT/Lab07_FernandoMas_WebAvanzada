<%- include('partials/head', { title }) %>
<section class="auth-stage">
    <div class="auth-showcase auth-showcase-wide">
        <div class="auth-copy">
            <span class="eyebrow light">Registro</span>
            <h1>Crea tu cuenta con datos completos y validaciones reales.</h1>
            <p>La contrasena debe tener minimo 8 caracteres, una mayuscula, un digito y uno de estos simbolos: `# $ % & * @`.</p>
        </div>
        <div class="card-panel form-card auth-form-card auth-form-card-wide">
            <h4>Sign up</h4>
            <p class="form-subtitle">Completa tus datos para registrarte como usuario.</p>
            <form id="sign-up-form">
                <div class="input-field">
                    <input id="name" name="name" type="text" required>
                    <label for="name">Nombre</label>
                </div>
                <div class="input-field">
                    <input id="lastName" name="lastName" type="text" required>
                    <label for="lastName">Apellido</label>
                </div>
                <div class="input-field">
                    <input id="phoneNumber" name="phoneNumber" type="text" required>
                    <label for="phoneNumber">Telefono</label>
                </div>
                <div class="input-field">
                    <input id="birthdate" name="birthdate" type="date" required>
                    <label class="active" for="birthdate">Fecha de nacimiento</label>
                </div>
                <div class="input-field">
                    <input id="email" name="email" type="email" required>
                    <label for="email">Email</label>
                </div>
                <div class="input-field">
                    <input id="password" name="password" type="password" required>
                    <label for="password">Password</label>
                </div>
                <button class="btn waves-effect waves-light full-width" type="submit">Crear cuenta</button>
            </form>
            <p class="helper-text top-space">¿Ya tienes cuenta? <a href="/signIn">Inicia sesion</a>.</p>
        </div>
    </div>
</section>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        window.App.bindSignUpForm();
    });
</script>
<%- include('partials/foot') %>
